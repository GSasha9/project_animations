{
  "name": "new-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "prepare": "husky",
    "lint": "eslint --ext .ts,.html src",
    "lint:fix": "npm run format:fix && eslint --ext .ts,.html src --fix",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.1-alpha.8",
    "@angular-eslint/eslint-plugin": "^21.4.1-alpha.8",
    "@angular-eslint/eslint-plugin-template": "^21.4.1-alpha.8",
    "@angular-eslint/template-parser": "^21.4.1-alpha.8",
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "angular-cli-ghpages": "^3.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "sass": "^1.71.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
